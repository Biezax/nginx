+static ngx_int_t
+ngx_http_variable_correlation_id(ngx_http_request_t *r,
+    ngx_http_variable_value_t *v, uintptr_t data)
+{
+    r = r->main;
+
+    if (!r->correlation_id_ready) {
+        /* A read before ID selection must not cache a missing ID. */
+        v->not_found = 1;
+        v->no_cacheable = 1;
+        return NGX_OK;
+    }
+
+    v->len = sizeof(r->correlation_id);
+    v->valid = 1;
+    v->no_cacheable = 0;
+    v->not_found = 0;
+    v->data = r->correlation_id;
 
     return NGX_OK;
 }
