 static char *
+ngx_http_core_error_log_request_id(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_http_core_srv_conf_t  *cscf = conf;
+
+    ngx_str_t                  *value, name;
+    ngx_http_core_main_conf_t   *cmcf;
+
+    if (cscf->log_request_id != NGX_CONF_UNSET) {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+
+    if (ngx_strcmp(value[1].data, "off") == 0) {
+        cscf->log_request_id = 0;
+        return NGX_CONF_OK;
+    }
+
+    if (value[1].len < 2 || value[1].data[0] != '$') {
+        return "requires off or a variable";
+    }
+
+    name.len = value[1].len - 1;
+    name.data = value[1].data + 1;
+
+    if (name.len == sizeof("correlation_id") - 1
+        && ngx_strncasecmp(name.data, (u_char *) "correlation_id", name.len) == 0)
+    {
+        return "cannot use $correlation_id as its source";
+    }
+
+    cscf->request_id_source = ngx_http_get_variable_index(cf, &name);
+    if (cscf->request_id_source == NGX_ERROR) {
+        return NGX_CONF_ERROR;
+    }
+
+    cmcf = ngx_http_conf_get_module_main_conf(cf, ngx_http_core_module);
+    ngx_str_set(&name, "request_id");
+    cmcf->request_id_index = ngx_http_get_variable_index(cf, &name);
+    if (cmcf->request_id_index == NGX_ERROR) {
+        return NGX_CONF_ERROR;
+    }
+
+    cscf->log_request_id = 1;
+    return NGX_CONF_OK;
+}
