+void
+ngx_http_init_correlation_id(ngx_http_request_t *r)
+{
+    u_char                      c, *id;
+    size_t                      variables_size, snapshot_size;
+    ngx_uint_t                  i;
+    ngx_http_core_srv_conf_t    *cscf;
+    ngx_http_core_main_conf_t   *cmcf;
+    ngx_http_variable_value_t   *v, *saved_variables;
+#if (NGX_PCRE)
+    int                        *captures;
+    size_t                      captures_size;
+    u_char                     *captures_data;
+    ngx_uint_t                  ncaptures, realloc_captures;
+#endif
+
+    if (r != r->main || !r->correlation_id_pending) {
+        return;
+    }
+
+    r->correlation_id_pending = 0;
+
+    cscf = ngx_http_get_module_srv_conf(r, ngx_http_core_module);
+    if (!cscf->log_request_id || r->log_request_id.len != 32) {
+        return;
+    }
+
+    /* Select after post-read, or on rejection before entering the phases. */
+    id = r->log_request_id.data;
+    v = NULL;
+
+    /* Source evaluation must not change variable cache or regex captures. */
+    cmcf = ngx_http_get_module_main_conf(r, ngx_http_core_module);
+    variables_size = cmcf->variables.nelts * sizeof(ngx_http_variable_value_t);
+    snapshot_size = variables_size;
+
+#if (NGX_PCRE)
+    captures = r->captures;
+    ncaptures = r->ncaptures;
+    captures_data = r->captures_data;
+    realloc_captures = r->realloc_captures;
+    captures_size = captures != NULL ? ncaptures * sizeof(int) : 0;
+    snapshot_size += captures_size;
+#endif
+
+    saved_variables = ngx_palloc(r->pool, snapshot_size);
+
+    if (saved_variables != NULL) {
+        ngx_memcpy(saved_variables, r->variables, variables_size);
+#if (NGX_PCRE)
+        if (captures_size) {
+            ngx_memcpy((u_char *) saved_variables + variables_size,
+                       captures, captures_size);
+        }
+#endif
+        v = ngx_http_get_flushed_variable(r, cscf->request_id_source);
+    }
+
+    if (v != NULL && !v->not_found && v->len == 32) {
+        for (i = 0; i < 32; i++) {
+            c = ngx_tolower(v->data[i]);
+            if ((c < '0' || c > '9') && (c < 'a' || c > 'f')) {
+                break;
+            }
+        }
+
+        if (i == 32) {
+            id = v->data;
+        }
+    }
+
+    ngx_memcpy(r->correlation_id, id, 32);
+
+    if (saved_variables != NULL) {
+        ngx_memcpy(r->variables, saved_variables, variables_size);
+#if (NGX_PCRE)
+        if (captures_size) {
+            ngx_memcpy(captures, (u_char *) saved_variables + variables_size,
+                       captures_size);
+        }
+        r->captures = captures;
+        r->ncaptures = ncaptures;
+        r->captures_data = captures_data;
+        r->realloc_captures = realloc_captures;
+#endif
+        ngx_pfree(r->pool, saved_variables);
+    }
+
+    r->correlation_id_ready = 1;
 }
 
 
